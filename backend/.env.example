# ==========================================
# Shinobi Trials Backend Environment Configuration
# Use these environment variables in your Render Web Service dashboard
# ==========================================

# Server Port (Render sets this dynamically, defaults to 8080)
PORT=8080

# PostgreSQL Database Connection (Provided by Render PostgreSQL service)
SPRING_DATASOURCE_URL=jdbc:postgresql://<host>:5432/<dbname>
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=<password>

# Google Gemini API Key for dynamic AI question generation & Sensei grading
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_API_MODEL=gemini-3.6-flash

# Base URL for Certificate QR Code verification (Pointing to your live Vercel domain)
CERTIFICATE_BASE_URL=https://<your-app-name>.vercel.app/certificates
